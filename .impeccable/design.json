      "css": ".ds-btn-primary{background:var(--accent,#1F5FD1);color:#FFFFFF;font:600 12px/16px Archivo,system-ui,sans-serif;padding:6px 12px;border:1px solid var(--accent,#1F5FD1);border-radius:3px;cursor:pointer;transition:all 90ms steps(2,end)}.ds-btn-primary:hover{background:#1A51B3;border-color:#1A51B3}.ds-btn-primary:focus-visible{outline:2px solid var(--accent,#1F5FD1);outline-offset:2px}.ds-btn-primary:disabled{opacity:.5;cursor:not-allowed}"
    },
